{
  "name": "ai-dev-control-plane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "node --check eslint.config.js && node --check src/scheduler.js && node --check src/lib/schedulerCore.js && node --check src/config/secrets.js && node --check scripts/register_discord_commands.js && node --check scripts/auth/firebase-user.js && node --check scripts/auth/cloudrun-sync.js && node --check scripts/auth/auth-setup.js",
    "lint:eslint": "eslint src scripts",
    "lint:harness": "tsx scripts/ai/harness_lint.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "resume:session": "tsx src/session-continue-cli.ts",
    "scheduler": "tsx src/scheduler.js",
    "auth:setup": "node scripts/auth/auth-setup.js",
    "start:webhook": "tsx src/webhook-server.ts",
    "start:ngrok": "bash -c \"$NGROK_COMMAND\"",
    "dev:webhook": "concurrently --kill-others-on-fail=false \"npm run start:webhook\" \"npm run start:ngrok\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "benchmark:smoke": "tsx src/ptcg-release-benchmark-cli.ts smoke",
    "benchmark:scheduled": "tsx src/ptcg-release-benchmark-cli.ts scheduled"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "concurrently": "^8.2.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^29.0.0",
    "prettier": "^3.8.4",
    "supertest": "^6.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
