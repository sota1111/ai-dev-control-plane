.devcontainer/devcontainer-lock.json

# Node.js
node_modules/

# ptcg-battle-lab raw game logs (object store) — kept out of git; the manifest references them by
# object key + checksum + size (SOT-1713). Manifests under artifacts/ptcg-battle-lab/runs/ MAY be
# committed per-run as the git-managed artifact.
artifacts/ptcg-battle-lab/objects/
# ptcg-analyze regenerable outputs (SOT-1711) — aggregate.<run>.json / report.<run>.md are recomputed
# from the raw records on demand; kept out of git like the object store.
artifacts/ptcg-battle-lab/runs/aggregate.*.json
artifacts/ptcg-battle-lab/runs/report.*.md

# 環境変数（シークレットを含むため追跡しない）
.env
.env.local

docs/ai/auto_logs/*

# AI worker ephemeral artifacts (per-run pipeline reports — regenerated every run)
docs/ai/10_plan.md
docs/ai/20_design.md
docs/ai/30_tasks.md
docs/ai/40_acceptance.md
docs/ai/50_worker_antigravity_report.md
docs/ai/55_worker_claude_report.md
docs/ai/60_worker_codex_report.md
docs/ai/70_final_report.md
docs/ai/70_acceptance_check.md
docs/ai/75_github_report.md
docs/ai/80_linear_report.md
docs/ai/task_check_report.md
docs/ai/decomposition_report.md
docs/ai/*_proposal.md
prompts/antigravity/implement.md
prompts/codex/debug.md
prompts/claude/worker.md
docs/ai/linear/
docs/ai/pipeline/

# Local archive (not tracked)
.local/

# Authentication credential directories (bind mount for Dev Container persistence)
.claude/*
# ...but track version-controlled skills (SOT-1576) and shared hooks + settings (SOT-1573);
# credentials/local settings (settings.local.json) stay ignored
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.codex/
.antigravity/
.config/antigravity/
.config/gh/
.azure/
.config/gcloud/
.config/ngrok/
__pycache__/
