# Local archive (not tracked)
.local/

# Authentication credential directories (bind mount for Dev Container persistence)
.claude/*
# ...but track version-controlled skills (SOT-1576) and shared hooks + settings (SOT-1573);
# credentials/local settings (settings.local.json) stay ignored
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.codex/
.antigravity/
.config/antigravity/
.config/gh/
.azure/
.config/gcloud/
.config/ngrok/
__pycache__/

# --- one-off audit/dispatch lane artifacts (per-idx audit lanes; SOT-2717 full-100 codex audit) ---
docs/ai/60_worker_codex_report.aud*.md
docs/ai/60_worker_codex_report.idx*.md
prompts/codex/debug.aud*.md
prompts/roles/verification.aud*.md
