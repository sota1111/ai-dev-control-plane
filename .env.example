# ------------------------------------------------------------
# Ngrok
# ------------------------------------------------------------
NGROK_API_KEY=
NGROK_WEBHOOK_URL=
NGROK_COMMAND=

# Linear Webhook signing secret for HMAC-SHA256 verification.
# Get it from: Linear > Settings > API > Webhooks > your webhook > Secret
# If not set, the server runs in development mode without signature verification.
LINEAR_WEBHOOK_SECRET=

# Linear Personal API Token
# Required when using Linear polling mode.
# If empty, the scheduler runs in fallback interval mode.
# Get it from: Linear > Settings > API > Personal API keys
LINEAR_API_KEY=

# Anthropic API key for Claude Code
# Required for Claude Code to function.
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Linear polling interval in seconds.
# Used when LINEAR_API_KEY is set. Default: 60
CHECK_INTERVAL=60

# Fallback interval in seconds.
# Used when LINEAR_API_KEY is not set. Default: 3600
INTERVAL=3600

# Webhook mode: set to true to use webhook server instead of polling scheduler.
# When WEBHOOK_MODE=true:
#   - The polling scheduler (scheduler.sh) is disabled.
#   - Use 'npm run start:webhook' to start the persistent webhook server.
#   - Use 'npm run dev:webhook' to start webhook server + ngrok together.
#   - The webhook server runs as a daemon: it stays alive even if AI execution
#     (run_auto.sh / run_codex.sh) fails, is Terminated, or exits with error.
# When WEBHOOK_MODE=false (default):
#   - The polling scheduler runs on the interval defined by CHECK_INTERVAL / INTERVAL.
WEBHOOK_MODE=false

# Webhook server port (default: 3000)
PORT=3000

# Optional: timezone for logs and scheduled execution
# Example: Asia/Tokyo, UTC, America/New_York
TZ=Asia/Tokyo
