# ------------------------------------------------------------
# Ngrok
# ------------------------------------------------------------
NGROK_API_KEY=
NGROK_WEBHOOK_URL=
NGROK_COMMAND=

# Linear Webhook signing secret for HMAC-SHA256 verification.
# Get it from: Linear > Settings > API > Webhooks > your webhook > Secret
# If not set, the server runs in development mode without signature verification.
LINEAR_WEBHOOK_SECRET=

# Linear Personal API Token
# Required when using Linear polling mode.
# If empty, the scheduler runs in fallback interval mode.
# Get it from: Linear > Settings > API > Personal API keys
LINEAR_API_KEY=

# Anthropic API key for Claude Code
# Required for Claude Code to function.
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# discord
DISCORD_WEBHOOK_URL=
# Cooldown/usage-limit notification webhook. Falls back to DISCORD_WEBHOOK_URL if unset.
DISCORD_WEBHOOK_URL_NOTIFY=

# Discord Bot / Interactions (required for bidirectional bot)
# Get from Discord Developer Portal > your application
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Optional: register slash commands to a single guild for INSTANT updates.
# If set, `node scripts/register_discord_commands.js` registers to this guild
# (new/changed commands appear immediately). If unset, commands register
# globally (works everywhere but takes up to ~1 hour to propagate).
# Get the ID: Discord > User Settings > Advanced > Developer Mode ON, then
# right-click the server icon > Copy Server ID.
DISCORD_GUILD_ID=

# FireBase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
ALLOWED_USER_EMAILS=

# Linear polling interval in seconds.
# Used when LINEAR_API_KEY is set. Default: 60
CHECK_INTERVAL=60

# Fallback interval in seconds.
# Used when LINEAR_API_KEY is not set. Default: 3600
INTERVAL=3600

# Webhook mode: set to true to use webhook server instead of polling scheduler.
# When WEBHOOK_MODE=true:
#   - The polling scheduler (scheduler.sh) is disabled.
#   - Use 'npm run start:webhook' to start the persistent webhook server.
#   - Use 'npm run dev:webhook' to start webhook server + ngrok together.
#   - The webhook server runs as a daemon: it stays alive even if AI execution
#     (run_auto.sh / run_codex.sh) fails, is Terminated, or exits with error.
# When WEBHOOK_MODE=false (default):
#   - The polling scheduler runs on the interval defined by CHECK_INTERVAL / INTERVAL.
WEBHOOK_MODE=false

# Webhook server startup bootstrap scan.
# On startup the webhook server scans Linear for unprocessed (Todo/In Progress) issues
# and enqueues them for processing. Requires LINEAR_API_KEY.
# Default: true (enabled). Set to false to disable.
# WEBHOOK_BOOTSTRAP_SCAN_ENABLED=false

# Webhook server port (default: 3000)
PORT=3000

# Webhook server reaper (recovers stranded/detached runs). On by default; only the
# literal value 'false' disables it.
# WEBHOOK_REAPER_ENABLED=false
# Periodic queue drain interval in the webhook server, ms (default: 300000 = 5 min).
# QUEUE_DRAIN_INTERVAL_MS=300000
# Max interval between rescans for stranded In-Progress issues, ms (default: 300000 = 5 min).
# REAPER_STRANDED_MAX_INTERVAL_MS=300000

# Optional: timezone for logs and scheduled execution
# Example: Asia/Tokyo, UTC, America/New_York
TZ=Asia/Tokyo

# Usage limit detected: retry after reset + buffer seconds (default: 600 = 10 minutes)
USAGE_LIMIT_RETRY_BUFFER_SECONDS=600

# 529/overloaded 等のサーバ過負荷エラー後に再開するまでの待機秒数（既定3600=1時間）
OVERLOAD_RETRY_BUFFER_SECONDS=3600

# --- Runner queue tunables ---
# run_auto.sh のグローバル flock 競合時に再投入を遅らせるバックオフ, ms（既定60000=1分）。
# LOCK_CONFLICT_BACKOFF_MS=60000
# キュー項目が prune されるまでの最大保持日数（既定7）。
# QUEUE_ITEM_TTL_DAYS=7
# クラッシュで取り残された inflight 項目を回収するまでの最大経過, ms（既定7200000=2時間）。
# INFLIGHT_TTL_MS=7200000
# このLinearラベルが付いたIssueはデタッチでlong-run実行される（既定 'long-run'）。
# LONG_RUN_LABEL=long-run

# --- Runner concurrency (SOT-911 案A) ---
# RUNNER_MAX_PARALLEL=1            # N-slot parallel pool size; 1 = fully serial (default)
# RUNNER_SERIALIZE_SCOPE=repo      # 'repo' (default, 同一repo直列) | 'branch' (別branchは別laneで並行可)
# RUNNER_DEFAULT_DETACH=0          # 1/true → 通常runも既定でデタッチ実行（既定0=同期前景）
#
# Stable operation mode master switch (SOT-947). When enabled, forces fully-serial運用:
# overrides RUNNER_MAX_PARALLEL→1, RUNNER_SERIALIZE_SCOPE→repo, RUNNER_DEFAULT_DETACH→false,
# AND disables `long-run` label detach (long-run issues run synchronously). Default off = 後方互換.
# Set to 1/true to temporarily disable ALL concurrency with a single flag.
# RUNNER_STABLE_MODE=1
#
# Antigravity CLI disable switch (SOT-957). When truthy (1/true/yes/on), scripts/ai/run_antigravity.sh
# skips invoking `agy` and exits with the worker non-response code 75, so Claude takes over
# implementation via the Worker Non-Response Fallback Policy. Use while Antigravity CLI is unavailable
# (e.g. Google plan change). Default off = Antigravity runs as usual.
#
# SOT-1536: agy -p non-interactive silent-auth is broken on this Dev Container. keyring.go:95 discards a
# valid, non-expired file token after a fixed 5s keyringAuth timeout and falls to OAuth (which cannot
# complete non-interactively) → ~40s fail. Installing a working Secret Service (dbus-x11/libsecret/
# gnome-keyring) does NOT fix it — the 5s timeout fires even when secret-tool store/lookup succeeds.
# It is an upstream defect. Recommended: set ANTIGRAVITY_DISABLED=1 to skip the wasted ~40s probe and
# fall straight through to codex/claude (function unchanged). See
# docs/ai/investigations/SOT-1536-agy-auth-persistence.md. Re-enable once upstream fixes it.
# ANTIGRAVITY_DISABLED=1
#
# Codex CLI disable switch (SOT-1333). Symmetric to ANTIGRAVITY_DISABLED. When truthy (1/true/yes/on),
# scripts/ai/run_codex.sh skips invoking `codex` and exits 75, so the dispatcher hands off to the next
# worker in the chain. Default off = Codex runs.
# CODEX_DISABLED=1
#
# Claude worker disable switch (SOT-1533). Symmetric to the above. When truthy (1/true/yes/on),
# scripts/ai/run_claude.sh (the DISPATCHED claude worker) skips invoking `claude` and exits 75, so the
# dispatcher hands off to the next worker in the chain. Default off.
# CLAUDE_DISABLED=1
#
# NOTE: worker selection is governed solely by config/worker_roles.json, where each role maps to an
# ORDERED PRIORITY CHAIN of workers (e.g. "task-check": ["codex","claude","antigravity"]). The dispatcher
# scripts/ai/run_worker.sh <role> tries them in order and hands off to the next on non-response /
# usage-limit. The former global kill-switches ALL_CLAUDE_MODE and WORKER_MODE were removed. To run
# everything on Claude, set every role to ["claude"]. The per-worker disable flags above are temporary
# "worker is down" escape hatches, evaluated per worker AFTER chain selection.

# --- Secrets backend (SOT-699) ---
# SECRETS_BACKEND=secret-manager   # force Secret Manager; omit/`dotenv` for local .env fallback
# SECRET_MANAGER_PROJECT_ID=       # GCP project for Secret Manager (defaults to GOOGLE_CLOUD_PROJECT)
# SECRET_MANAGER_PREFIX=           # optional prefix prepended to env-var name to form the secret id

# --- Kaggle API (PTCG AI Battle Challenge) ---
# API token from https://www.kaggle.com/settings/api ("Create New Token").
# Either paste the JSON token value here, or install the downloaded kaggle.json at ~/.kaggle/kaggle.json.
KAGGLE_USERNAME=sota1111
KAGGLE_API_TOKEN=
