# ------------------------------------------------------------
# Ngrok
# ------------------------------------------------------------
NGROK_API_KEY=
NGROK_WEBHOOK_URL=
NGROK_COMMAND=

# Linear Webhook signing secret for HMAC-SHA256 verification.
# Get it from: Linear > Settings > API > Webhooks > your webhook > Secret
# If not set, the server runs in development mode without signature verification.
LINEAR_WEBHOOK_SECRET=

# Linear Personal API Token
# Required when using Linear polling mode.
# If empty, the scheduler runs in fallback interval mode.
# Get it from: Linear > Settings > API > Personal API keys
LINEAR_API_KEY=

# Anthropic API key for Claude Code
# Required for Claude Code to function.
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# discord
DISCORD_WEBHOOK_URL=
# Cooldown/usage-limit notification webhook. Falls back to DISCORD_WEBHOOK_URL if unset.
DISCORD_WEBHOOK_URL_NOTIFY=

# Discord Bot / Interactions (required for bidirectional bot)
# Get from Discord Developer Portal > your application
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Optional: register slash commands to a single guild for INSTANT updates.
# If set, `node scripts/register_discord_commands.js` registers to this guild
# (new/changed commands appear immediately). If unset, commands register
# globally (works everywhere but takes up to ~1 hour to propagate).
# Get the ID: Discord > User Settings > Advanced > Developer Mode ON, then
# right-click the server icon > Copy Server ID.
DISCORD_GUILD_ID=

# FireBase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
ALLOWED_USER_EMAILS=

# Linear polling interval in seconds.
# Used when LINEAR_API_KEY is set. Default: 60
CHECK_INTERVAL=60

# Fallback interval in seconds.
# Used when LINEAR_API_KEY is not set. Default: 3600
INTERVAL=3600

# Webhook mode: set to true to use webhook server instead of polling scheduler.
# When WEBHOOK_MODE=true:
#   - The polling scheduler (scheduler.sh) is disabled.
#   - Use 'npm run start:webhook' to start the persistent webhook server.
#   - Use 'npm run dev:webhook' to start webhook server + ngrok together.
#   - The webhook server runs as a daemon: it stays alive even if AI execution
#     (run_auto.sh / run_codex.sh) fails, is Terminated, or exits with error.
# When WEBHOOK_MODE=false (default):
#   - The polling scheduler runs on the interval defined by CHECK_INTERVAL / INTERVAL.
WEBHOOK_MODE=false

# Webhook server startup bootstrap scan.
# On startup the webhook server scans Linear for unprocessed (Todo/In Progress) issues
# and enqueues them for processing. Requires LINEAR_API_KEY.
# Default: true (enabled). Set to false to disable.
# WEBHOOK_BOOTSTRAP_SCAN_ENABLED=false

# Webhook server port (default: 3000)
PORT=3000

# Optional: timezone for logs and scheduled execution
# Example: Asia/Tokyo, UTC, America/New_York
TZ=Asia/Tokyo

# Usage limit detected: retry after reset + buffer seconds (default: 600 = 10 minutes)
USAGE_LIMIT_RETRY_BUFFER_SECONDS=600

# 529/overloaded 等のサーバ過負荷エラー後に再開するまでの待機秒数（既定3600=1時間）
OVERLOAD_RETRY_BUFFER_SECONDS=3600

# --- Runner concurrency (SOT-911 案A) ---
# RUNNER_MAX_PARALLEL=1            # N-slot parallel pool size; 1 = fully serial (default)
# RUNNER_SERIALIZE_SCOPE=repo      # 'repo' (default, 同一repo直列) | 'branch' (別branchは別laneで並行可)
# RUNNER_DEFAULT_DETACH=0          # 1/true → 通常runも既定でデタッチ実行（既定0=同期前景）
#
# Stable operation mode master switch (SOT-947). When enabled, forces fully-serial運用:
# overrides RUNNER_MAX_PARALLEL→1, RUNNER_SERIALIZE_SCOPE→repo, RUNNER_DEFAULT_DETACH→false,
# AND disables `long-run` label detach (long-run issues run synchronously). Default off = 後方互換.
# Set to 1/true to temporarily disable ALL concurrency with a single flag.
# RUNNER_STABLE_MODE=1
#
# Gemini CLI disable switch (SOT-957). When truthy (1/true/yes/on), scripts/ai/run_gemini.sh
# skips invoking `gemini` and exits with the worker non-response code 75, so Claude takes over
# implementation via the Worker Non-Response Fallback Policy. Use while Gemini CLI is unavailable
# (e.g. Google plan change). Default off = Gemini runs as usual.
# GEMINI_DISABLED=1

# --- Secrets backend (SOT-699) ---
# SECRETS_BACKEND=secret-manager   # force Secret Manager; omit/`dotenv` for local .env fallback
# SECRET_MANAGER_PROJECT_ID=       # GCP project for Secret Manager (defaults to GOOGLE_CLOUD_PROJECT)
# SECRET_MANAGER_PREFIX=           # optional prefix prepended to env-var name to form the secret id
